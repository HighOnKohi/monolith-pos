create table public."Discounts" (
  "DISCOUNT_ID" bigint generated by default as identity not null,
  "ORDER_ID" bigint not null,
  "ORDER_ITEM_ID" bigint null,
  "PWD" boolean null default false,
  "PWD_AMOUNT" bigint null default '0'::bigint,
  "SENIOR" boolean null default false,
  "SENIOR_AMOUNT" bigint null default '0'::bigint,
  "CUSTOM_PERCENT" bigint null default '0'::bigint,
  "PESO_DISCOUNT" double precision null default '0'::double precision,
  constraint DISCOUNTS_pkey primary key ("DISCOUNT_ID"),
  constraint DISCOUNTS_ORDER_ID_fkey foreign KEY ("ORDER_ID") references "Restaurant_Orders" ("ORDER_ID") on delete cascade,
  constraint DISCOUNTS_ORDER_ITEM_ID_fkey foreign KEY ("ORDER_ITEM_ID") references "Order_Items" ("ORDER_ITEM_ID") on delete cascade
) TABLESPACE pg_default;

create table public."Menu_Categories" (
  "CATEGORY_ID" bigint generated by default as identity not null,
  "CATEGORY_NAME" text not null,
  constraint Menu_Categories_pkey primary key ("CATEGORY_ID")
) TABLESPACE pg_default;

create table public."Menu_Items" (
  "ITEM_ID" bigint generated by default as identity not null,
  "CATEGORY_ID" bigint not null,
  "ITEM_NAME" text null,
  "ITEM_DESCRIPTION" text null,
  "ITEM_PRICE" double precision null,
  "ITEM_IMAGE" text null,
  "ITEM_IMAGE_URL" text null,
  "ITEM_STATUS" text null default 'AVAILABLE'::text,
  constraint MENU_ITEMS_pkey primary key ("ITEM_ID"),
  constraint Menu_Items_CATEGORY_ID_fkey foreign KEY ("CATEGORY_ID") references "Menu_Categories" ("CATEGORY_ID"),
  constraint menu_items_status_check check (
    (
      "ITEM_STATUS" = any (array['AVAILABLE'::text, 'OUT_OF_STOCK'::text])
    )
  )
) TABLESPACE pg_default;

create table public."Order_Items" (
  "ORDER_ITEM_ID" bigint generated by default as identity not null,
  "ORDER_ID" bigint not null,
  "ITEM_ID" bigint null,
  "DISCOUNT_ID" bigint null,
  "ORDER_ITEM_STATUS" text null default 'PENDING'::text,
  "QUANTITY" bigint null default '1'::bigint,
  constraint Order_Items_pkey primary key ("ORDER_ITEM_ID"),
  constraint Order_Items_ITEM_ID_fkey foreign KEY ("ITEM_ID") references "Menu_Items" ("ITEM_ID"),
  constraint Order_Items_ORDER_ID_fkey foreign KEY ("ORDER_ID") references "Restaurant_Orders" ("ORDER_ID"),
  constraint Order_Items_ORDER_ITEM_STATUS_check check (
    (
      "ORDER_ITEM_STATUS" = any (
        array[
          'PENDING'::text,
          'PREPARING'::text,
          'DONE'::text,
          'CANCELLED'::text
        ]
      )
    )
  )
) TABLESPACE pg_default;

create table public."Restaurant_Orders" (
  "ORDER_ID" bigint generated by default as identity not null,
  "TABLE_ID" bigint not null,
  "REQUESTED_FROM" text null default 'None'::text,
  "ORDER_TYPE" text null default 'Dine-in'::text,
  "ORDER_STATUS" text null default 'Pending'::text,
  "SUBTOTAL_BILL" double precision null default '0'::double precision,
  "TOTAL_BILL" double precision null default '0'::double precision,
  "TIME" timestamp without time zone null,
  constraint customer_orders_order_id_unique unique ("ORDER_ID"),
  constraint Customer_Orders_TABLE_ID_fkey foreign KEY ("TABLE_ID") references "Restaurant_Tables" ("TABLE_ID"),
  constraint Restaurant_Orders_ORDER_STATUS_check check (
    (
      "ORDER_STATUS" = any (
        array[
          'REQUESTED'::text,
          'PREPARING'::text,
          'READY'::text,
          'SERVED'::text
        ]
      )
    )
  ),
  constraint restaurant_orders_order_status_check check (
    (
      "ORDER_STATUS" = any (
        array[
          'REQUESTED'::text,
          'VERIFIED'::text,
          'PREPARING'::text,
          'READY'::text,
          'SERVED'::text
        ]
      )
    )
  ),
  constraint restaurant_orders_requested_from_check check (
    (
      "REQUESTED_FROM" = any (array['Cashier'::text, 'Customer'::text])
    )
  ),
  constraint restaurant_orders_type_check check (
    (
      "ORDER_TYPE" = any (array['DINE_IN'::text, 'TAKEOUT'::text])
    )
  )
) TABLESPACE pg_default;

create table public."Restaurant_Tables" (
  "TABLE_ID" bigint generated by default as identity not null,
  "TABLE_NUM" bigint not null default '0'::bigint,
  "STATUS" text null,
  "GUEST_CAPACITY" bigint null default '0'::bigint,
  "CURRENT_GUEST_COUNT" bigint null default '0'::bigint,
  "RESERVED_SINCE" timestamp without time zone null,
  "BILL_OUT_REQUESTED" boolean null default false,
  constraint Restaurant_Tables_pkey primary key ("TABLE_ID"),
  constraint restaurant_tables_status_check check (
    (
      "STATUS" = any (
        array[
          'AVAILABLE'::text,
          'RESERVED'::text,
          'OCCUPIED'::text,
          'HAS_REQUEST'::text
        ]
      )
    )
  )
) TABLESPACE pg_default;

create table public."Bill_Requests" (
  "REQUEST_ID" bigint generated by default as identity not null,
  "TABLE_ID" bigint not null,
  "ORDER_ID" bigint null,
  "PAYMENT_METHOD" text not null,
  "STATUS" text not null default 'REQUESTED'::text,
  "REQUESTED_AT" timestamp without time zone default now(),
  constraint Bill_Requests_pkey primary key ("REQUEST_ID"),
  constraint bill_requests_table_id_fkey foreign KEY ("TABLE_ID") references "Restaurant_Tables" ("TABLE_ID") on delete cascade,
  constraint bill_requests_order_id_fkey foreign KEY ("ORDER_ID") references "Restaurant_Orders" ("ORDER_ID") on delete set null,
  constraint bill_requests_payment_check check (
    (
      "PAYMENT_METHOD" = any (array['CASH'::text, 'CREDIT_CARD'::text, 'INSTAPAY_QR'::text])
    )
  ),
  constraint bill_requests_status_check check (
    (
      "STATUS" = any (
        array['REQUESTED'::text, 'PROCESSING'::text, 'PAID'::text, 'CANCELLED'::text]
      )
    )
  )
) TABLESPACE pg_default;
